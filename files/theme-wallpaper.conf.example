# theme-wallpaper.conf
# Pick the wallpaper that matches the active theme mode (dark/light) in KDE Plasma or Noctalia.
#
# Lines are KEY=VALUE. Blank lines and lines starting with # are ignored.
# Paths may be absolute or start with ~. Surrounding quotes are stripped.
# This file is read fresh on every switch, so edits apply immediately --
# no reload needed.

# ---------------------------------------------------------------- required
# fixed  = one exact image per mode, uses DARK_WALLPAPER / LIGHT_WALLPAPER
# random = a random image from DARK_DIR / LIGHT_DIR on every switch
# cycle  = walks DARK_DIR / LIGHT_DIR in order, wrapping, so nothing repeats
#          until every image has been used once
STRATEGY = fixed

# ---------------------------------------------------------------- fixed mode
# STRATEGY = fixed uses these. Only the one matching the active mode is read.
# Defaults below point at real files in your wallpaper folder -- edit freely.
#   available: wallhaven-lighthouse.png
#              wallhaven-ogyo57.jpg
#              wallhaven-pomo69_1920x1080.png
#              wallhaven-yqvk1k.png
LIGHT_WALLPAPER = ~/Pictures/Wallpapers/wallhaven-pomo69_1920x1080.png
DARK_WALLPAPER  = ~/Pictures/Wallpapers/wallhaven-yqvk1k.png

# ---------------------------------------------------------------- folder modes
# STRATEGY = random / cycle use these. Only the matching mode's folder is scanned.
# Only image files sitting directly inside are used -- subfolders are ignored.
DARK_DIR  = ~/Pictures/Wallpapers/dark
LIGHT_DIR = ~/Pictures/Wallpapers/light

# ---------------------------------------------------------------- optional
# Leave empty to apply to every connected output, which keeps them in sync.
# Set a space-separated list to use a different image per monitor, e.g.:
# CONNECTORS = eDP-1 HDMI-A-1
CONNECTORS =

# ------------------------------------------------------------- KDE lock screen
# On KDE Plasma the lock screen is kscreenlocker_greet. It reads its background
# from the Greeter group in ~/.config/kscreenlockerrc every time you lock, so the
# hook writes that file. Nothing else needs to reload.
#
# LOCKSCREEN_SYNC = false disables this entirely and touches nothing.
LOCKSCREEN_SYNC = true

# desktop = the lock screen shows the same image as the desktop (default).
# custom  = the lock screen uses its own image per mode, chosen below.
LOCKSCREEN_SOURCE = desktop

# Only read when LOCKSCREEN_SOURCE = custom. Leave empty to fall back to the
# desktop wallpaper for that mode, so a half-filled setup still behaves.
LOCKSCREEN_DARK_WALLPAPER  =
LOCKSCREEN_LIGHT_WALLPAPER =

# ------------------------------------------------- KDE Plasma state overrides
# If you use both KDE Plasma and Noctalia, you can set separate folders or
# wallpapers for KDE. When set, these take priority in a KDE session, leaving
# the base keys for Noctalia/KineticWE.
#
# KDE_STRATEGY = fixed
# KDE_LIGHT_WALLPAPER = ~/Pictures/Wallpapers/light/kde-day.png
# KDE_DARK_WALLPAPER  = ~/Pictures/Wallpapers/dark/kde-night.png
# KDE_LIGHT_DIR       = ~/Pictures/Wallpapers/kde-light
# KDE_DARK_DIR        = ~/Pictures/Wallpapers/kde-dark

# ------------------------------------------------------------------- palette
# Who generates the colour palette. Note: in KDE Plasma, palettes are managed
# by KDE Material You Colors and these settings are bypassed.
#
# noctalia -> Noctalia generates it from the wallpaper, with the scheme named in
#             PALETTE_SCHEME. The tool does not touch the palette, so the
#             wallpaper and Noctalia's own scheme apply.
# ours     -> this tool generates a palette from the wallpaper and applies it as
#             a Noctalia custom palette.
# random   -> the same, but the accent colours are randomised around the hue of
#             the wallpaper, so each wallpaper still feels like itself.
#
# Setting this to noctalia hands the palette back to Noctalia completely.
PALETTE_GENERATOR = noctalia

# The scheme Noctalia uses when PALETTE_GENERATOR = noctalia.
PALETTE_SCHEME = m3-rainbow

# How the two modes relate to the wallpaper, used when PALETTE_GENERATOR is
# ours or random.
#
# duotone -> the image's real hues are kept. Light is washed out and high key,
#            dark is deep and saturated.
# tonal   -> one seed hue for all three accents, the way Noctalia's own
#            schemes work.
PALETTE_VARIANT = duotone

# The seed for the random generator. The same seed and the same wallpaper always
# give the same palette. Change it to get a different one.
PALETTE_SEED = 0

# What to do when the wallpaper has a palette saved for it.
#
# always -> draw a new palette every time. This is the default.
# prefer -> use the saved palette for that wallpaper instead.
PALETTE_SAVED = always
